#!/usr/bin/env bash
# --------------------------------------------------------------------------------
# motif-balance
# scripts/preflight
#
# Prepare the environment and check repository prerequisites.
#
# Module Author(s): Eric J. South
# Dunlop Lab
# --------------------------------------------------------------------------------
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

strict=false
if [[ $# -gt 1 ]]; then
  echo "usage: bash ./scripts/preflight [--strict]" >&2
  exit 2
fi
if [[ $# -eq 1 ]]; then
  if [[ "$1" != "--strict" ]]; then
    echo "unknown option: $1" >&2
    exit 2
  fi
  strict=true
fi

command -v git >/dev/null
command -v uv >/dev/null
git rev-parse --show-toplevel >/dev/null
uv lock --check
uv sync --locked --all-extras

if [[ "$strict" == true ]]; then
  uv run --locked python scripts/check_architecture.py
  uv run --locked python scripts/check_docs.py
  uv run --locked python scripts/check_public_safety.py
fi

echo "Preflight: ok"
