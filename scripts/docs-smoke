#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

uv run --locked python scripts/check_docs.py
uv run --locked python - <<'PY'
import motif_balance as mb
from typer.main import get_command

from motif_balance.cli import app

expected = {
    "Candidate",
    "DesignSpec",
    "MotifMatch",
    "MotifModel",
    "Portfolio",
    "design",
    "score",
}
if set(mb.__all__) != expected:
    raise SystemExit(
        "top-level scientific surface differs from the documented five nouns and two verbs: "
        f"{sorted(mb.__all__)}"
    )
print("Documented scientific surface: ok")

command = get_command(app)
visible = sorted(name for name, child in command.commands.items() if not child.hidden)
if visible != ["design", "inspect", "score"]:
    raise SystemExit(f"ordinary CLI surface differs from the three documented journeys: {visible}")
print("Documented ordinary CLI surface: ok")
PY

smoke_root="$(mktemp -d)"
trap 'rm -rf "$smoke_root"' EXIT

uv run --locked motif-balance --help >"$smoke_root/help.txt"

uv run --locked motif-balance design examples/synthetic-pairwise/design.yaml --check >/dev/null
uv run --locked motif-balance score examples/synthetic-pairwise/design.yaml AT --format json \
  >"$smoke_root/score.json"
grep -Fq '"balance_score"' "$smoke_root/score.json"

uv run --locked motif-balance design examples/synthetic-pairwise/design.yaml \
  --out "$smoke_root/result" >/dev/null
uv run --locked motif-balance inspect "$smoke_root/result" >/dev/null
uv run --locked motif-balance inspect "$smoke_root/result" \
  --format html --out "$smoke_root/review.html" >/dev/null
for heading in "Candidate realization" "Portfolio balance" "Search record"; do
  grep -Fq "$heading" "$smoke_root/review.html"
done
if grep -Eq '<script|<foreignObject|href=|url\(' "$smoke_root/review.html"; then
  echo "inspection review contains an active or external resource" >&2
  exit 1
fi

for view in candidate portfolio search; do
  uv run --locked motif-balance inspect "$smoke_root/result" \
    --format svg --view "$view" --out "$smoke_root/${view}.svg" >/dev/null
  grep -Fq '<title ' "$smoke_root/${view}.svg"
  grep -Fq '<desc ' "$smoke_root/${view}.svg"
  if grep -Eq '<script|<foreignObject|href=|url\(' "$smoke_root/${view}.svg"; then
    echo "$view SVG contains an active or external resource" >&2
    exit 1
  fi
done
grep -Fq 'id="primary-sequence"' "$smoke_root/candidate.svg"
grep -Fq 'id="score-matrix"' "$smoke_root/portfolio.svg"
grep -Fq 'id="search-record"' "$smoke_root/search.svg"
cmp "$smoke_root/candidate.svg" examples/synthetic-pairwise/candidate-review.svg

uv run --locked motif-balance integration catalog \
  --entry smoke=bundle:"$smoke_root/result" \
  --format html --out "$smoke_root/catalog.html" >/dev/null

echo "Documentation smoke: ok"
