#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

uv run --locked python scripts/check_docs.py
uv run --locked python - <<'PY'
import motif_balance as mb

expected = {
    "Candidate",
    "DesignSpec",
    "Evaluation",
    "MotifMatch",
    "MotifModel",
    "Portfolio",
    "ResultCatalog",
    "ResultIndex",
    "ResultInspection",
    "build_result_catalog",
    "inspect_result",
    "design",
    "render_inspection_html",
    "render_result_catalog_html",
    "score",
}
missing = sorted(name for name in expected if not hasattr(mb, name))
if missing:
    raise SystemExit(f"public documentation surface is missing: {', '.join(missing)}")
print("Documented public surface: ok")
PY
uv run --locked motif-balance --help >/dev/null

smoke_root="$(mktemp -d)"
trap 'rm -rf "$smoke_root"' EXIT
uv run --locked motif-balance design examples/synthetic-pairwise/design.yaml --check >/dev/null
uv run --locked motif-balance design examples/synthetic-pairwise/design.yaml \
  --out "$smoke_root/result" >/dev/null
uv run --locked python -c \
  'import sys; from motif_balance import verify_bundle; print(verify_bundle(sys.argv[1]))' \
  "$smoke_root/result" >/dev/null
uv run --locked motif-balance inspect "$smoke_root/result" --kind bundle >/dev/null
uv run --locked motif-balance inspect "$smoke_root/result" --kind bundle \
  --format html --out "$smoke_root/review.html" >/dev/null
grep -Fq "Where motif scores land" "$smoke_root/review.html"
grep -Fq "Best-so-far search progress" "$smoke_root/review.html"
if grep -Eq '<script|<foreignObject|href=|url\(' "$smoke_root/review.html"; then
  echo "inspection review contains an active or external resource" >&2
  exit 1
fi
uv run --locked motif-balance catalog --entry smoke=bundle:"$smoke_root/result" \
  --format html --out "$smoke_root/catalog.html" >/dev/null

echo "Documentation smoke: ok"
