#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

smoke_root="$(mktemp -d)"
trap 'rm -rf "$smoke_root"' EXIT

if [[ $# -gt 1 ]]; then
  echo "usage: bash ./scripts/wheel-smoke [distribution-directory]" >&2
  exit 2
fi

if [[ $# -eq 1 ]]; then
  dist_dir="$1"
  test -d "$dist_dir" || { echo "missing distribution directory: $dist_dir" >&2; exit 1; }
else
  dist_dir="$smoke_root/dist"
  uv build --no-sources --out-dir "$dist_dir"
fi

shopt -s nullglob
wheels=("$dist_dir"/*.whl)
sdists=("$dist_dir"/*.tar.gz)
[[ ${#wheels[@]} -eq 1 ]] || { echo "expected exactly one wheel" >&2; exit 1; }
[[ ${#sdists[@]} -eq 1 ]] || { echo "expected exactly one source distribution" >&2; exit 1; }
wheel_path="${wheels[0]}"
sdist_path="${sdists[0]}"

uv run --locked twine check "$wheel_path" "$sdist_path"
wheel_contents="$(python3 -m zipfile -l "$wheel_path")"
for forbidden in '/tests/' '/scripts/' '/.github/' '/.agents/'; do
  if grep -Fq "$forbidden" <<<"$wheel_contents"; then
    echo "wheel contains repository-only path: $forbidden" >&2
    exit 1
  fi
done
sdist_contents="$(tar -tzf "$sdist_path")"
for forbidden in '/.git/' '/.venv/' '/.artifacts/'; do
  if grep -Fq "$forbidden" <<<"$sdist_contents"; then
    echo "source distribution contains local path: $forbidden" >&2
    exit 1
  fi
done
for required in LICENSE README.md IA.md ARCHITECTURE.md DESIGN.md RELIABILITY.md SECURITY.md assets/motif-balance-banner.svg docs/index.md docs/quickstart.md docs/score-sequences.md docs/reference/execution-receipts.md docs/reference/result-inspection.md; do
  if ! grep -Fq "/$required" <<<"$sdist_contents"; then
    echo "source distribution omits routed content: $required" >&2
    exit 1
  fi
done
for required in examples/formats/synthetic.jaspar examples/synthetic-pairwise/design.yaml examples/synthetic-pairwise/candidate-review.svg examples/synthetic-multimotif/design.yaml examples/production-pairwise/design.yaml; do
  if ! grep -Fq "/$required" <<<"$sdist_contents"; then
    echo "source distribution omits reproducibility input: $required" >&2
    exit 1
  fi
done

uv venv --python 3.12 "$smoke_root/venv"
uv pip install --python "$smoke_root/venv/bin/python" "$wheel_path"
uv pip check --python "$smoke_root/venv/bin/python"

contract_program='import inspect,json; import motif_balance as m; names=("MotifModel","DesignSpec","MotifMatch","Candidate","Portfolio"); operations=("design","score"); assert set(m.__all__) == set(names + operations); print(json.dumps({"models":{n:getattr(m,n).model_json_schema() for n in names},"operations":{n:str(inspect.signature(getattr(m,n))) for n in operations}},sort_keys=True))'
source_contract="$(uv run --locked python -c "$contract_program")"
wheel_contract="$("$smoke_root/venv/bin/python" -c "$contract_program")"
if [[ "$source_contract" != "$wheel_contract" ]]; then
  echo "source/wheel public contract mismatch" >&2
  exit 1
fi

uv run --locked motif-balance --help >"$smoke_root/source-help.txt"
"$smoke_root/venv/bin/motif-balance" --help >"$smoke_root/wheel-help.txt"
cmp "$smoke_root/source-help.txt" "$smoke_root/wheel-help.txt"

uv run --locked motif-balance design examples/synthetic-pairwise/design.yaml \
  --check >"$smoke_root/source-check.txt"
"$smoke_root/venv/bin/motif-balance" design examples/synthetic-pairwise/design.yaml \
  --check >"$smoke_root/wheel-check.txt"
cmp "$smoke_root/source-check.txt" "$smoke_root/wheel-check.txt"

uv run --locked motif-balance motif prepare examples/formats/synthetic.jaspar \
  --motif-id converted \
  --background 0.25,0.25,0.25,0.25 \
  --prior-weight 0.1 \
  --out "$smoke_root/source-converted.yaml" >/dev/null
"$smoke_root/venv/bin/motif-balance" motif prepare examples/formats/synthetic.jaspar \
  --motif-id converted \
  --background 0.25,0.25,0.25,0.25 \
  --prior-weight 0.1 \
  --out "$smoke_root/wheel-converted.yaml" >/dev/null
cmp "$smoke_root/source-converted.yaml" "$smoke_root/wheel-converted.yaml"

uv run --locked motif-balance design examples/synthetic-pairwise/design.yaml \
  --out "$smoke_root/source-result" >/dev/null
"$smoke_root/venv/bin/motif-balance" design examples/synthetic-pairwise/design.yaml \
  --out "$smoke_root/wheel-result" >/dev/null
diff -qr "$smoke_root/source-result" "$smoke_root/wheel-result"
bundle_id="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["bundle_id"])' "$smoke_root/source-result/manifest.json")"
uv run --locked motif-balance inspect "$smoke_root/source-result" \
  --expected-bundle-id "$bundle_id" >/dev/null
"$smoke_root/venv/bin/motif-balance" inspect "$smoke_root/wheel-result" \
  --expected-bundle-id "$bundle_id" >/dev/null
uv run --locked motif-balance inspect "$smoke_root/source-result" \
  --expected-bundle-id "$bundle_id" --format html \
  --out "$smoke_root/source-review.html" >/dev/null
"$smoke_root/venv/bin/motif-balance" inspect "$smoke_root/wheel-result" \
  --expected-bundle-id "$bundle_id" --format html \
  --out "$smoke_root/wheel-review.html" >/dev/null
cmp "$smoke_root/source-review.html" "$smoke_root/wheel-review.html"

# Exercise the explicit reader with genuinely v1-scored run-manifest/v2 bytes.
"$smoke_root/venv/bin/python" - examples/synthetic-pairwise/design.yaml "$smoke_root/legacy-v2-result" <<'PY'
import sys
from pathlib import Path

from motif_balance.artifacts import artifact_records, base_artifact_payloads, bundle_id, manifest_bytes
from motif_balance.compile import build_run_id, compile_design
from motif_balance.constants import BUILD_LOCK_SHA256, RUNTIME_CONTRACT
from motif_balance.formats.design import load_design_spec
from motif_balance.model import DesignSpec, MotifModel, RunManifest
from motif_balance.search import search
from motif_balance.selection import select_candidates

current = load_design_spec(Path(sys.argv[1]))
target = Path(sys.argv[2])
motifs = tuple(
    MotifModel.model_validate(
        {**motif.model_dump(mode="python"), "schema_version": "motif-model/v1"}
    )
    for motif in current.motifs
)
spec = DesignSpec(
    schema_version="design-spec/v1",
    motifs=motifs,
    length=current.length,
    count=current.count,
    strands=current.strands,
    evaluations=current.evaluations,
    seed=current.seed,
    min_distance=current.min_distance,
    scoring_semantics="normalized_llr_v1",
)
problem = compile_design(spec)
result = search(problem)
legacy_diagnostics = result.diagnostics.model_copy(
    update={
        "schema_version": "search-diagnostics/v1",
        "restart_final_constraint_statuses": (),
    }
)
candidates = select_candidates(
    result.evaluations,
    count=spec.count,
    min_distance=spec.min_distance,
    evaluations_used=result.evaluations_used,
)
report = b"<!doctype html><title>Released Motif Balance v2 report</title>\n"
payloads = base_artifact_payloads(spec, candidates)
payloads["report.html"] = report
run_id = build_run_id(
    spec,
    problem.problem_id,
    result.engine,
    result.engine_version,
    package_version="0.2.0a3",
)
provisional = RunManifest(
    schema_version="run-manifest/v2",
    package_version="0.2.0a3",
    runtime_contract=RUNTIME_CONTRACT,
    build_lock_sha256=BUILD_LOCK_SHA256,
    problem_id=problem.problem_id,
    run_id=run_id,
    bundle_id="bundle-000000000000000000000000",
    search_engine=result.engine,
    search_engine_version=result.engine_version,
    rng=result.rng,
    evaluation_count=result.evaluations_used,
    unique_evaluations=result.unique_evaluations,
    completion_status=result.completion_status,
    search_validation_status=result.search_validation_status,
    search_diagnostics=legacy_diagnostics,
    artifacts=artifact_records(payloads),
)
sealed = provisional.model_copy(update={"bundle_id": bundle_id(provisional)})
target.mkdir()
for name, payload in payloads.items():
    (target / name).write_bytes(payload)
(target / "manifest.json").write_bytes(manifest_bytes(sealed))
PY
legacy_bundle_id="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["bundle_id"])' "$smoke_root/legacy-v2-result/manifest.json")"
uv run --locked motif-balance inspect "$smoke_root/legacy-v2-result" \
  --expected-bundle-id "$legacy_bundle_id" >/dev/null
"$smoke_root/venv/bin/motif-balance" inspect "$smoke_root/legacy-v2-result" \
  --expected-bundle-id "$legacy_bundle_id" >/dev/null

for view in candidate portfolio search; do
  uv run --locked motif-balance inspect "$smoke_root/source-result" \
    --format svg --view "$view" --out "$smoke_root/source-${view}.svg" >/dev/null
  "$smoke_root/venv/bin/motif-balance" inspect "$smoke_root/wheel-result" \
    --format svg --view "$view" --out "$smoke_root/wheel-${view}.svg" >/dev/null
  cmp "$smoke_root/source-${view}.svg" "$smoke_root/wheel-${view}.svg"
done

behavior_program='import json,sys; import motif_balance as m; from motif_balance.artifacts import read_verified_portfolio; from motif_balance.compile import compile_design; from motif_balance.formats.design import load_design_spec; from motif_balance.inspection import inspect_result; spec=load_design_spec(sys.argv[1]); portfolio=read_verified_portfolio(sys.argv[2]); inspection=inspect_result(sys.argv[2],kind="bundle",expected_bundle_id=portfolio.manifest.bundle_id); result={"problem_id":compile_design(spec).problem_id,"evaluation":m.score("AT",spec).model_dump(mode="json"),"portfolio_id":portfolio.manifest.bundle_id,"inspection_id":inspection.run.bundle_id}; print(json.dumps(result,sort_keys=True))'
source_behavior="$(uv run --locked python -c "$behavior_program" examples/synthetic-pairwise/design.yaml "$smoke_root/source-result")"
wheel_behavior="$("$smoke_root/venv/bin/python" -c "$behavior_program" examples/synthetic-pairwise/design.yaml "$smoke_root/wheel-result")"
if [[ "$source_behavior" != "$wheel_behavior" ]]; then
  echo "source/wheel public behavior mismatch" >&2
  exit 1
fi

observation_program='import json; from motif_balance import DesignSpec,MotifModel; from motif_balance.observation import observe_evaluated_pool; target=MotifModel(motif_id="target",probabilities=((0.7,0.1,0.1,0.1),),background=(0.25,0.25,0.25,0.25)); avoider=MotifModel(motif_id="avoid",probabilities=((0.7,0.1,0.1,0.1),),background=(0.25,0.25,0.25,0.25)); spec=DesignSpec(motifs={"target":target},avoiders={"avoid":{"motif":avoider,"score_ceiling":0.0}},length=1,count=1,strands="forward",evaluations=4,seed=11); value=observe_evaluated_pool(spec); print(json.dumps({"id":value.observation_id,"schema":value.schema_version,"count":value.evaluation_count,"feasible":sum(row.constraint_feasible for row in value.evaluations)},sort_keys=True))'
source_observation="$(uv run --locked python -c "$observation_program")"
wheel_observation="$("$smoke_root/venv/bin/python" -c "$observation_program")"
if [[ "$source_observation" != "$wheel_observation" ]]; then
  echo "source/wheel evaluated-pool observation mismatch" >&2
  exit 1
fi

uv run --locked motif-balance design examples/synthetic-multimotif/design.yaml \
  --out "$smoke_root/source-multimotif-result" >/dev/null
"$smoke_root/venv/bin/motif-balance" design examples/synthetic-multimotif/design.yaml \
  --out "$smoke_root/wheel-multimotif-result" >/dev/null
diff -qr "$smoke_root/source-multimotif-result" "$smoke_root/wheel-multimotif-result"
"$smoke_root/venv/bin/motif-balance" inspect "$smoke_root/wheel-multimotif-result" >/dev/null
uv run --locked motif-balance inspect "$smoke_root/source-multimotif-result" \
  --format html --out "$smoke_root/source-multimotif-review.html" >/dev/null
"$smoke_root/venv/bin/motif-balance" inspect "$smoke_root/wheel-multimotif-result" \
  --format html --out "$smoke_root/wheel-multimotif-review.html" >/dev/null
cmp "$smoke_root/source-multimotif-review.html" "$smoke_root/wheel-multimotif-review.html"

uv run --locked motif-balance design examples/production-pairwise/design.yaml \
  --out "$smoke_root/source-production-result" >/dev/null
"$smoke_root/venv/bin/motif-balance" design examples/production-pairwise/design.yaml \
  --out "$smoke_root/wheel-production-result" >/dev/null
diff -qr "$smoke_root/source-production-result" "$smoke_root/wheel-production-result"
"$smoke_root/venv/bin/motif-balance" inspect "$smoke_root/wheel-production-result" >/dev/null
uv run --locked motif-balance inspect "$smoke_root/source-production-result" \
  --format json >"$smoke_root/source-inspection.json"
"$smoke_root/venv/bin/motif-balance" inspect "$smoke_root/wheel-production-result" \
  --format json >"$smoke_root/wheel-inspection.json"
cmp "$smoke_root/source-inspection.json" "$smoke_root/wheel-inspection.json"

producer_revision="${MOTIF_BALANCE_PRODUCER_REVISION:-0000000000000000000000000000000000000000}"
uv run --locked motif-balance orchestration execute examples/production-pairwise/design.yaml \
  --release-artifact "$wheel_path" \
  --producer-revision "$producer_revision" \
  --out "$smoke_root/source-execution" >/dev/null
"$smoke_root/venv/bin/motif-balance" orchestration execute examples/production-pairwise/design.yaml \
  --release-artifact "$wheel_path" \
  --producer-revision "$producer_revision" \
  --out "$smoke_root/wheel-execution" >/dev/null
diff -qr "$smoke_root/source-execution/bundle" "$smoke_root/wheel-execution/bundle"
release_sha256="$(shasum -a 256 "$wheel_path" | awk '{print $1}')"
for execution in "$smoke_root/source-execution" "$smoke_root/wheel-execution"; do
  read -r execution_id receipt_sha256 < <(
    "$smoke_root/venv/bin/python" -c \
      'import json,sys; value=json.load(open(sys.argv[1])); print(value["workspace_id"], value["receipt"]["sha256"])' \
      "$execution/execution-workspace.json"
  )
  "$smoke_root/venv/bin/motif-balance" inspect "$execution" --source execution \
    --expected-workspace-id "$execution_id" \
    --expected-receipt-sha256 "$receipt_sha256" \
    --expected-release-sha256 "$release_sha256" \
    --expected-producer-revision "$producer_revision" >/dev/null
  "$smoke_root/venv/bin/motif-balance" inspect "$execution" --source execution \
    --expected-workspace-id "$execution_id" \
    --expected-receipt-sha256 "$receipt_sha256" \
    --expected-release-sha256 "$release_sha256" \
    --expected-producer-revision "$producer_revision" --format json >/dev/null
done

installed_version="$("$smoke_root/venv/bin/python" -c 'from importlib.metadata import version; print(version("motif-balance"))')"
project_version="$(uv run --locked python -c 'import tomllib; print(tomllib.load(open("pyproject.toml", "rb"))["project"]["version"])')"
test "$installed_version" = "$project_version"

echo "Distribution smoke and source parity: ok ($installed_version)"
