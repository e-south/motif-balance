#!/usr/bin/env bash
# --------------------------------------------------------------------------------
# motif-balance
# scripts/wheel-smoke
#
# Compare installed distributions with source APIs and documented workflows.
#
# Module Author(s): Eric J. South
# Dunlop Lab
# --------------------------------------------------------------------------------
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

smoke_root="$(mktemp -d)"
trap 'rm -rf "$smoke_root"' EXIT

if [[ $# -gt 1 ]]; then
  echo "usage: bash ./scripts/wheel-smoke [distribution-directory]" >&2
  exit 2
fi

if [[ $# -eq 1 ]]; then
  dist_dir="$1"
  test -d "$dist_dir" || { echo "missing distribution directory: $dist_dir" >&2; exit 1; }
else
  dist_dir="$smoke_root/dist"
  uv build --no-sources --out-dir "$dist_dir"
fi

shopt -s nullglob
wheels=("$dist_dir"/*.whl)
sdists=("$dist_dir"/*.tar.gz)
[[ ${#wheels[@]} -eq 1 ]] || { echo "expected exactly one wheel" >&2; exit 1; }
[[ ${#sdists[@]} -eq 1 ]] || { echo "expected exactly one source distribution" >&2; exit 1; }
wheel_path="${wheels[0]}"
sdist_path="${sdists[0]}"

uv run --locked twine check "$wheel_path" "$sdist_path"
wheel_contents="$(python3 -m zipfile -l "$wheel_path")"
for forbidden in '/tests/' '/scripts/' '/.github/' '/.agents/'; do
  if grep -Fq "$forbidden" <<<"$wheel_contents"; then
    echo "wheel contains repository-only path: $forbidden" >&2
    exit 1
  fi
done
sdist_contents="$(tar -tzf "$sdist_path")"
for forbidden in '/.git/' '/.venv/' '/.artifacts/' '/examples/argr-cra/inputs/'; do
  if grep -Fq "$forbidden" <<<"$sdist_contents"; then
    echo "source distribution contains local path: $forbidden" >&2
    exit 1
  fi
done
for required in LICENSE README.md IA.md ARCHITECTURE.md DESIGN.md RELIABILITY.md SECURITY.md assets/motif-balance-banner.svg docs/README.md docs/quickstart.md docs/score-sequences.md docs/reference/execution-receipts.md docs/reference/result-inspection.md; do
  if ! grep -Fq "/$required" <<<"$sdist_contents"; then
    echo "source distribution omits routed content: $required" >&2
    exit 1
  fi
done
for required in examples/argr-cra/design.yaml examples/argr-cra/prepare_inputs.py examples/argr-cra/SOURCE.json examples/formats/synthetic.jaspar examples/synthetic-pairwise/design.yaml examples/synthetic-pairwise/candidate-review.svg examples/synthetic-multimotif/design.yaml examples/production-pairwise/design.yaml; do
  if ! grep -Fq "/$required" <<<"$sdist_contents"; then
    echo "source distribution omits reproducibility input: $required" >&2
    exit 1
  fi
done

smoke_python="${MOTIF_BALANCE_SMOKE_PYTHON:-3.12}"
uv venv --python "$smoke_python" "$smoke_root/venv"
uv pip install --python "$smoke_root/venv/bin/python" "$wheel_path"
uv pip check --python "$smoke_root/venv/bin/python"

contract_program='import importlib.util,inspect,json; import motif_balance as m; assert importlib.util.find_spec("motif_balance.observation") is None; names=("MotifModel","MotifSpecification","DesignSpec","MotifMatch","Candidate","Portfolio"); operations=("design","score"); assert set(m.__all__) == set(names + operations); print(json.dumps({"models":{n:getattr(m,n).model_json_schema() for n in names},"operations":{n:str(inspect.signature(getattr(m,n))) for n in operations}},sort_keys=True))'
source_contract="$(uv run --locked python -c "$contract_program")"
wheel_contract="$("$smoke_root/venv/bin/python" -c "$contract_program")"
if [[ "$source_contract" != "$wheel_contract" ]]; then
  echo "source/wheel public contract mismatch" >&2
  exit 1
fi

# Install the source distribution independently to catch missing build inputs.
uv venv --python "$smoke_python" "$smoke_root/sdist-venv"
uv pip install --python "$smoke_root/sdist-venv/bin/python" "$sdist_path"
uv pip check --python "$smoke_root/sdist-venv/bin/python"
sdist_contract="$("$smoke_root/sdist-venv/bin/python" -c "$contract_program")"
if [[ "$source_contract" != "$sdist_contract" ]]; then
  echo "source/sdist public contract mismatch" >&2
  exit 1
fi
"$smoke_root/sdist-venv/bin/motif-balance" --help >"$smoke_root/sdist-help.txt"

uv run --locked motif-balance --help >"$smoke_root/source-help.txt"
"$smoke_root/venv/bin/motif-balance" --help >"$smoke_root/wheel-help.txt"
cmp "$smoke_root/source-help.txt" "$smoke_root/wheel-help.txt"
cmp "$smoke_root/source-help.txt" "$smoke_root/sdist-help.txt"

uv run --locked motif-balance assess examples/synthetic-pairwise/motifs/motif-a.yaml \
  examples/synthetic-pairwise/motifs/motif-b.yaml --length 2 --format json \
  >"$smoke_root/source-assessment.json"
"$smoke_root/venv/bin/motif-balance" assess examples/synthetic-pairwise/motifs/motif-a.yaml \
  examples/synthetic-pairwise/motifs/motif-b.yaml --length 2 --format json \
  >"$smoke_root/wheel-assessment.json"
cmp "$smoke_root/source-assessment.json" "$smoke_root/wheel-assessment.json"
uv run --locked motif-balance assess examples/synthetic-pairwise/motifs/motif-a.yaml \
  examples/synthetic-pairwise/motifs/motif-b.yaml --length 2 --format svg \
  --out "$smoke_root/source-assessment.svg"
"$smoke_root/venv/bin/motif-balance" assess examples/synthetic-pairwise/motifs/motif-a.yaml \
  examples/synthetic-pairwise/motifs/motif-b.yaml --length 2 --format svg \
  --out "$smoke_root/wheel-assessment.svg"
cmp "$smoke_root/source-assessment.svg" "$smoke_root/wheel-assessment.svg"
"$smoke_root/venv/bin/python" - "$smoke_root/wheel-assessment.json" <<'PY'
import sys
from pathlib import Path
from motif_balance.assessment import PairAssessment

assessment = PairAssessment.model_validate_json(Path(sys.argv[1]).read_bytes())
assert assessment.structural_score == 1.0
assert assessment.sequence_evaluations == 0
assert assessment.arrangement_count == 2
assert assessment.best_arrangement.right_strand == "-"
print("Installed assessment API/CLI and source parity: ok")
PY

"$smoke_root/venv/bin/python" - "$smoke_root/joint-third.json" <<'PY'
import sys
from pathlib import Path
from motif_balance import MotifModel
model = MotifModel(motif_id="third", probabilities=((0.7, 0.1, 0.1, 0.1),) * 2,
                   background=(0.25,) * 4)
Path(sys.argv[1]).write_text(model.model_dump_json())
PY
uv run --locked motif-balance assess examples/synthetic-pairwise/motifs/motif-a.yaml \
  examples/synthetic-pairwise/motifs/motif-b.yaml --additional "$smoke_root/joint-third.json" \
  --length 2 --format json >"$smoke_root/source-joint.json"
"$smoke_root/venv/bin/motif-balance" assess examples/synthetic-pairwise/motifs/motif-a.yaml \
  examples/synthetic-pairwise/motifs/motif-b.yaml --additional "$smoke_root/joint-third.json" \
  --length 2 --format json >"$smoke_root/wheel-joint.json"
cmp "$smoke_root/source-joint.json" "$smoke_root/wheel-joint.json"
"$smoke_root/venv/bin/python" - "$smoke_root/wheel-joint.json" <<'PY'
import sys
from pathlib import Path
from motif_balance.assessment import JointAssessment
assessment = JointAssessment.model_validate_json(Path(sys.argv[1]).read_bytes())
assert len(assessment.motifs) == 3 and assessment.arrangement_count == 4
assert assessment.sequence_evaluations == 0
assert assessment.proof == "exact_minimum_over_admitted_arrangements"
print("Installed joint assessment and source/CLI parity: ok")
PY

# Exercise the installed collection command over the same verified saved pool.
"$smoke_root/venv/bin/python" - "$smoke_root/collection-source" <<'PY'
import sys
from motif_balance import DesignSpec, MotifModel, MotifSpecification, design
motifs = tuple(MotifModel(motif_id=name, probabilities=(row,) * 2, background=(0.25,) * 4)
               for name, row in (("a", (0.7, 0.1, 0.1, 0.1)), ("b", (0.1, 0.7, 0.1, 0.1))))
spec = DesignSpec(schema_version="design-spec/v3", specifications=tuple(
    MotifSpecification(motif=m, direction="seek") for m in motifs),
    length=4, count=1, strands="forward", seed=7, evaluations=256)
result = design(spec)
result.write(sys.argv[1])
from pathlib import Path
Path(sys.argv[1] + ".identity").write_text(result.manifest.bundle_id)
PY
collection_id="$(cat "$smoke_root/collection-source.identity")"
uv run --locked motif-balance collect "$smoke_root/collection-source" \
  --expected-bundle-id "$collection_id" --count 100 --format json >"$smoke_root/source-collection.json"
"$smoke_root/venv/bin/motif-balance" collect "$smoke_root/collection-source" \
  --expected-bundle-id "$collection_id" --count 100 --format json >"$smoke_root/wheel-collection.json"
cmp "$smoke_root/source-collection.json" "$smoke_root/wheel-collection.json"
"$smoke_root/venv/bin/python" - "$smoke_root/wheel-collection.json" <<'PY'
import json, sys
from pathlib import Path
from motif_balance.model.alternatives import ArchitectureCollection, ArchitectureRanking
record = json.loads(Path(sys.argv[1]).read_text())
ranking = ArchitectureRanking.model_validate(record["ranking"])
collection = ArchitectureCollection.model_validate(record["collection"])
assert collection == ranking.select_up_to(100)
assert 2 < collection.delivered_count < 100
assert collection.status == "insufficient_retained_architectures"
assert ranking.grouping == "interval_topology"
print("Installed collection API/CLI and source parity: ok")
PY

"$smoke_root/venv/bin/python" examples/argr-cra/prepare_inputs.py --out "$smoke_root/argr-cra-inputs"
source_python="$(uv run --locked python -c 'import sys; print(sys.executable)')"
for guide in README.md docs/python-api.md docs/pair-assessment.md docs/choose-alternatives.md docs/reference/portfolio-selection.md docs/reference/search-observations.md; do
  guide_program="$(python3 - "$repo_root/$guide" <<'PY'
import re
import sys
from pathlib import Path

guide_path = Path(sys.argv[1])
guide = guide_path.read_text()
blocks = re.findall(r"```python\n(.*?)```", guide, flags=re.DOTALL)
assert blocks, f"no runnable Python example in {guide_path.name}"
print("\n".join(blocks))
if guide_path.name == "choose-alternatives.md":
    print("print(ranking.model_dump_json())\nprint(recovered.model_dump_json())")
if guide_path.name == "portfolio-selection.md":
    print("print(result.model_dump_json())")
if guide_path.name == "search-observations.md":
    print("print(observation.model_dump_json())")
PY
)"
  guide_name="${guide##*/}"
  guide_name="${guide_name%.md}"
  mkdir "$smoke_root/source-$guide_name" "$smoke_root/wheel-$guide_name"
  if [[ "$guide" == "README.md" || "$guide" == "docs/python-api.md" ]]; then
    mkdir -p "$smoke_root/source-$guide_name/examples" "$smoke_root/wheel-$guide_name/examples"
    for environment in source wheel; do
      example_destination="$smoke_root/$environment-$guide_name/examples/argr-cra"
      mkdir "$example_destination"
      cp examples/argr-cra/design.yaml examples/argr-cra/SOURCE.json "$example_destination/"
      cp -R "$smoke_root/argr-cra-inputs" "$example_destination/inputs"
    done
  fi
  if [[ "$guide" == "README.md" ]]; then
    cp -R "$smoke_root/argr-cra-inputs" "$smoke_root/source-$guide_name/inputs"
    cp -R "$smoke_root/argr-cra-inputs" "$smoke_root/wheel-$guide_name/inputs"
  fi
  source_guide="$(cd "$smoke_root/source-$guide_name" && "$source_python" -c "$guide_program")"
  wheel_guide="$(cd "$smoke_root/wheel-$guide_name" && "$smoke_root/venv/bin/python" -c "$guide_program")"
  if [[ "$source_guide" != "$wheel_guide" ]]; then
    echo "source/wheel $guide example output or record mismatch" >&2
    exit 1
  fi
  diff -qr "$smoke_root/source-$guide_name" "$smoke_root/wheel-$guide_name"
  echo "Installed $guide in an isolated directory and source parity: ok"
done

uv run --locked motif-balance design examples/synthetic-pairwise/design.yaml \
  --check >"$smoke_root/source-check.txt"
"$smoke_root/venv/bin/motif-balance" design examples/synthetic-pairwise/design.yaml \
  --check >"$smoke_root/wheel-check.txt"
cmp "$smoke_root/source-check.txt" "$smoke_root/wheel-check.txt"

uv run --locked motif-balance motif prepare examples/formats/synthetic.jaspar \
  --motif-id converted \
  --background 0.25,0.25,0.25,0.25 \
  --out "$smoke_root/source-converted.yaml" >/dev/null
"$smoke_root/venv/bin/motif-balance" motif prepare examples/formats/synthetic.jaspar \
  --motif-id converted \
  --background 0.25,0.25,0.25,0.25 \
  --out "$smoke_root/wheel-converted.yaml" >/dev/null
cmp "$smoke_root/source-converted.yaml" "$smoke_root/wheel-converted.yaml"

uv run --locked motif-balance design examples/synthetic-pairwise/design.yaml \
  --out "$smoke_root/source-result" >/dev/null
"$smoke_root/venv/bin/motif-balance" design examples/synthetic-pairwise/design.yaml \
  --out "$smoke_root/wheel-result" >/dev/null
diff -qr "$smoke_root/source-result" "$smoke_root/wheel-result"
bundle_id="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["bundle_id"])' "$smoke_root/source-result/manifest.json")"
uv run --locked motif-balance inspect "$smoke_root/source-result" \
  --expected-bundle-id "$bundle_id" >/dev/null
"$smoke_root/venv/bin/motif-balance" inspect "$smoke_root/wheel-result" \
  --expected-bundle-id "$bundle_id" >/dev/null
uv run --locked motif-balance inspect "$smoke_root/source-result" \
  --expected-bundle-id "$bundle_id" --format html \
  --out "$smoke_root/source-review.html" >/dev/null
"$smoke_root/venv/bin/motif-balance" inspect "$smoke_root/wheel-result" \
  --expected-bundle-id "$bundle_id" --format html \
  --out "$smoke_root/wheel-review.html" >/dev/null
cmp "$smoke_root/source-review.html" "$smoke_root/wheel-review.html"


for view in candidate portfolio search; do
  uv run --locked motif-balance inspect "$smoke_root/source-result" \
    --format svg --view "$view" --out "$smoke_root/source-${view}.svg" >/dev/null
  "$smoke_root/venv/bin/motif-balance" inspect "$smoke_root/wheel-result" \
    --format svg --view "$view" --out "$smoke_root/wheel-${view}.svg" >/dev/null
  cmp "$smoke_root/source-${view}.svg" "$smoke_root/wheel-${view}.svg"
done

behavior_program='import json,sys; import motif_balance as m; from motif_balance.artifacts import read_verified_portfolio; from motif_balance.compile import compile_design; from motif_balance.formats.design import load_design_spec; from motif_balance.inspection import inspect_result; spec=load_design_spec(sys.argv[1]); portfolio=read_verified_portfolio(sys.argv[2]); inspection=inspect_result(sys.argv[2],kind="bundle",expected_bundle_id=portfolio.manifest.bundle_id); result={"problem_id":compile_design(spec).problem_id,"evaluation":m.score("AT",spec).model_dump(mode="json"),"portfolio_id":portfolio.manifest.bundle_id,"inspection_id":inspection.run.bundle_id}; print(json.dumps(result,sort_keys=True))'
source_behavior="$(uv run --locked python -c "$behavior_program" examples/synthetic-pairwise/design.yaml "$smoke_root/source-result")"
wheel_behavior="$("$smoke_root/venv/bin/python" -c "$behavior_program" examples/synthetic-pairwise/design.yaml "$smoke_root/wheel-result")"
if [[ "$source_behavior" != "$wheel_behavior" ]]; then
  echo "source/wheel public behavior mismatch" >&2
  exit 1
fi

uv run --locked motif-balance design examples/synthetic-multimotif/design.yaml \
  --out "$smoke_root/source-multimotif-result" >/dev/null
"$smoke_root/venv/bin/motif-balance" design examples/synthetic-multimotif/design.yaml \
  --out "$smoke_root/wheel-multimotif-result" >/dev/null
diff -qr "$smoke_root/source-multimotif-result" "$smoke_root/wheel-multimotif-result"
"$smoke_root/venv/bin/motif-balance" inspect "$smoke_root/wheel-multimotif-result" >/dev/null
uv run --locked motif-balance inspect "$smoke_root/source-multimotif-result" \
  --format html --out "$smoke_root/source-multimotif-review.html" >/dev/null
"$smoke_root/venv/bin/motif-balance" inspect "$smoke_root/wheel-multimotif-result" \
  --format html --out "$smoke_root/wheel-multimotif-review.html" >/dev/null
cmp "$smoke_root/source-multimotif-review.html" "$smoke_root/wheel-multimotif-review.html"

uv run --locked motif-balance design examples/production-pairwise/design.yaml \
  --out "$smoke_root/source-production-result" >/dev/null
"$smoke_root/venv/bin/motif-balance" design examples/production-pairwise/design.yaml \
  --out "$smoke_root/wheel-production-result" >/dev/null
diff -qr "$smoke_root/source-production-result" "$smoke_root/wheel-production-result"
"$smoke_root/venv/bin/motif-balance" inspect "$smoke_root/wheel-production-result" >/dev/null
uv run --locked motif-balance inspect "$smoke_root/source-production-result" \
  --format json >"$smoke_root/source-inspection.json"
"$smoke_root/venv/bin/motif-balance" inspect "$smoke_root/wheel-production-result" \
  --format json >"$smoke_root/wheel-inspection.json"
cmp "$smoke_root/source-inspection.json" "$smoke_root/wheel-inspection.json"

producer_revision="${MOTIF_BALANCE_PRODUCER_REVISION:-0000000000000000000000000000000000000000}"
uv run --locked motif-balance orchestration execute examples/production-pairwise/design.yaml \
  --release-artifact "$wheel_path" \
  --producer-revision "$producer_revision" \
  --out "$smoke_root/source-execution" >/dev/null
"$smoke_root/venv/bin/motif-balance" orchestration execute examples/production-pairwise/design.yaml \
  --release-artifact "$wheel_path" \
  --producer-revision "$producer_revision" \
  --out "$smoke_root/wheel-execution" >/dev/null
diff -qr "$smoke_root/source-execution/bundle" "$smoke_root/wheel-execution/bundle"
release_sha256="$(shasum -a 256 "$wheel_path" | awk '{print $1}')"
for execution in "$smoke_root/source-execution" "$smoke_root/wheel-execution"; do
  read -r execution_id receipt_sha256 < <(
    "$smoke_root/venv/bin/python" -c \
      'import json,sys; value=json.load(open(sys.argv[1])); print(value["workspace_id"], value["receipt"]["sha256"])' \
      "$execution/execution-workspace.json"
  )
  "$smoke_root/venv/bin/motif-balance" inspect "$execution" --source execution \
    --expected-workspace-id "$execution_id" \
    --expected-receipt-sha256 "$receipt_sha256" \
    --expected-release-sha256 "$release_sha256" \
    --expected-producer-revision "$producer_revision" >/dev/null
  "$smoke_root/venv/bin/motif-balance" inspect "$execution" --source execution \
    --expected-workspace-id "$execution_id" \
    --expected-receipt-sha256 "$receipt_sha256" \
    --expected-release-sha256 "$release_sha256" \
    --expected-producer-revision "$producer_revision" --format json >/dev/null
done

installed_version="$("$smoke_root/venv/bin/python" -c 'from importlib.metadata import version; print(version("motif-balance"))')"
project_version="$(uv run --locked python -c 'import tomllib; print(tomllib.load(open("pyproject.toml", "rb"))["project"]["version"])')"
test "$installed_version" = "$project_version"

echo "Distribution smoke and source parity: ok ($installed_version)"
