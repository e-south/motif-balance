#!/usr/bin/env bash
# --------------------------------------------------------------------------------
# motif-balance
# scripts/verify
#
# Run the package verification and release-readiness checks.
#
# Module Author(s): Eric J. South
# Dunlop Lab
# --------------------------------------------------------------------------------
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

bash ./scripts/preflight --strict
uv run --locked ruff check .
uv run --locked ruff format --check .
uv run --locked mypy src
uv run --locked python -m compileall -q src/motif_balance scripts
mkdir -p .artifacts
uv run --locked pytest \
  --cov=motif_balance \
  --cov-report=term-missing \
  --cov-report=xml:.artifacts/coverage.xml \
  -q
bash ./scripts/docs-smoke
uv export --locked --all-extras --no-dev --no-emit-project \
  --format requirements-txt \
  --output-file .artifacts/operational-requirements.txt >/dev/null
uv run --locked pip-audit \
  --requirement .artifacts/operational-requirements.txt \
  --no-deps \
  --disable-pip
bash ./scripts/wheel-smoke

echo "Verification: ok"
