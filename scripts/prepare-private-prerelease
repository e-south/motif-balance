#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

out_dir=""
builder_kind=""
limitations=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --out)
      [[ $# -ge 2 ]] || { echo "--out requires a value" >&2; exit 2; }
      out_dir="$2"
      shift 2
      ;;
    --builder-kind)
      [[ $# -ge 2 ]] || { echo "--builder-kind requires a value" >&2; exit 2; }
      builder_kind="$2"
      shift 2
      ;;
    --limitation)
      [[ $# -ge 2 ]] || { echo "--limitation requires a value" >&2; exit 2; }
      limitations+=("$2")
      shift 2
      ;;
    *)
      echo "unknown option: $1" >&2
      exit 2
      ;;
  esac
done

[[ -n "$out_dir" ]] || { echo "--out is required" >&2; exit 2; }
[[ "$out_dir" == /* ]] || {
  echo "--out must be an absolute path outside the repository" >&2
  exit 2
}
out_dir="$(python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve())' "$out_dir")"
case "$out_dir" in
  "$repo_root"|"$repo_root"/*)
    echo "--out must be outside the repository" >&2
    exit 2
    ;;
esac
[[ "$builder_kind" == "maintainer_local" || "$builder_kind" == "github_actions" ]] || {
  echo "--builder-kind must be maintainer_local or github_actions" >&2
  exit 2
}
[[ ${#limitations[@]} -gt 0 ]] || { echo "at least one --limitation is required" >&2; exit 2; }
[[ ! -e "$out_dir" && ! -L "$out_dir" ]] || {
  echo "refusing existing output path: $out_dir" >&2
  exit 1
}
[[ -z "$(git status --porcelain)" ]] || { echo "release checkout is not clean" >&2; exit 1; }
git merge-base --is-ancestor HEAD origin/main

version="$(uv run --locked python -c 'import tomllib; print(tomllib.load(open("pyproject.toml", "rb"))["project"]["version"])')"
uv run --locked python -c \
  'import re,sys; assert re.fullmatch(r"[0-9]+(?:\.[0-9]+){2}(?:a|b|rc)[0-9]+", sys.argv[1])' \
  "$version"
tag="v${version}"
if git rev-parse --verify --quiet "refs/tags/${tag}" >/dev/null; then
  [[ "$(git rev-parse "${tag}^{commit}")" == "$(git rev-parse HEAD)" ]] || {
    echo "release tag points to a different commit: $tag" >&2
    exit 1
  }
fi

bash ./scripts/agent-verify
source_date_epoch="$(git show -s --format=%ct HEAD)"
release_revision="$(git rev-parse HEAD)"
snapshot_root="$(mktemp -d)"
trap 'rm -rf -- "$snapshot_root"' EXIT
git archive --format=tar HEAD | tar -xf - -C "$snapshot_root"
mkdir -p "$out_dir"
(
  cd "$snapshot_root"
  SOURCE_DATE_EPOCH="$source_date_epoch" uv build --no-sources --out-dir "$out_dir"
  MOTIF_BALANCE_PRODUCER_REVISION="$release_revision" \
    bash ./scripts/wheel-smoke "$out_dir"
)
[[ "$(git rev-parse HEAD)" == "$release_revision" ]] || {
  echo "release source revision changed during build" >&2
  exit 1
}
[[ -z "$(git status --porcelain --untracked-files=all)" ]] || {
  echo "release checkout changed during build" >&2
  exit 1
}

attestation_args=(
  create
  --directory "$out_dir"
  --builder-kind "$builder_kind"
  --source-date-epoch "$source_date_epoch"
)
for limitation in "${limitations[@]}"; do
  attestation_args+=(--limitation "$limitation")
done
uv run --locked python scripts/release_attestation.py "${attestation_args[@]}"
uv run --locked python scripts/release_attestation.py verify \
  --directory "$out_dir" \
  --repository-root "$repo_root"
test -f "$out_dir/release-build-attestation.json"
test -f "$out_dir/SHA256SUMS"

echo "Private prerelease assets prepared: $out_dir"
