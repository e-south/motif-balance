#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

out_dir=""
builder_kind=""
limitations=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --out)
      [[ $# -ge 2 ]] || { echo "--out requires a value" >&2; exit 2; }
      out_dir="$2"
      shift 2
      ;;
    --builder-kind)
      [[ $# -ge 2 ]] || { echo "--builder-kind requires a value" >&2; exit 2; }
      builder_kind="$2"
      shift 2
      ;;
    --limitation)
      [[ $# -ge 2 ]] || { echo "--limitation requires a value" >&2; exit 2; }
      limitations+=("$2")
      shift 2
      ;;
    *)
      echo "unknown option: $1" >&2
      exit 2
      ;;
  esac
done

[[ -n "$out_dir" ]] || { echo "--out is required" >&2; exit 2; }
[[ "$out_dir" == /* ]] || {
  echo "--out must be an absolute path outside the repository" >&2
  exit 2
}
[[ ! -e "$out_dir" && ! -L "$out_dir" ]] || {
  echo "refusing existing output path: $out_dir" >&2
  exit 1
}
out_dir="$(python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve())' "$out_dir")"
case "$out_dir" in
  "$repo_root"|"$repo_root"/*)
    echo "--out must be outside the repository" >&2
    exit 2
    ;;
esac
[[ "$builder_kind" == "maintainer_local" || "$builder_kind" == "github_actions" ]] || {
  echo "--builder-kind must be maintainer_local or github_actions" >&2
  exit 2
}
[[ ${#limitations[@]} -gt 0 ]] || { echo "at least one --limitation is required" >&2; exit 2; }
[[ ! -e "$out_dir" && ! -L "$out_dir" ]] || {
  echo "refusing existing output path: $out_dir" >&2
  exit 1
}
out_parent="$(dirname "$out_dir")"
[[ -d "$out_parent" && ! -L "$out_parent" ]] || {
  echo "output parent must be an existing regular directory: $out_parent" >&2
  exit 2
}
mkdir -- "$out_dir"
output_identity() {
  python3 -c \
    'import os,stat,sys; value=os.lstat(sys.argv[1]); assert stat.S_ISDIR(value.st_mode); print(f"{value.st_dev}:{value.st_ino}")' \
    "$out_dir"
}
out_identity="$(output_identity)"

[[ -z "$(git status --porcelain --untracked-files=all)" ]] || {
  echo "release checkout is not clean" >&2
  exit 1
}
release_revision="$(git rev-parse HEAD)"
git merge-base --is-ancestor "$release_revision" origin/main

version="$(
  git show "${release_revision}:pyproject.toml" |
    uv run --locked python -c \
      'import sys,tomllib; print(tomllib.loads(sys.stdin.read())["project"]["version"])'
)"
uv run --locked python -c \
  'import re,sys; assert re.fullmatch(r"[0-9]+(?:\.[0-9]+){2}(?:a|b|rc)[0-9]+", sys.argv[1])' \
  "$version"
tag="v${version}"
if git rev-parse --verify --quiet "refs/tags/${tag}" >/dev/null; then
  [[ "$(git cat-file -t "refs/tags/${tag}")" == "tag" ]] || {
    echo "release tag is not annotated: $tag" >&2
    exit 1
  }
  [[ "$(git rev-parse "${tag}^{commit}")" == "$release_revision" ]] || {
    echo "release tag points to a different commit: $tag" >&2
    exit 1
  }
fi

bash ./scripts/agent-verify
[[ "$(git rev-parse HEAD)" == "$release_revision" ]] || {
  echo "release source revision changed during verification" >&2
  exit 1
}
[[ -z "$(git status --porcelain --untracked-files=all)" ]] || {
  echo "release checkout changed during verification" >&2
  exit 1
}
[[ "$(output_identity)" == "$out_identity" ]] || {
  echo "release output directory changed during verification" >&2
  exit 1
}
source_date_epoch="$(git show -s --format=%ct "$release_revision")"
snapshot_root="$(mktemp -d)"
build_root="$(mktemp -d)"
trap 'rm -rf -- "$snapshot_root" "$build_root"' EXIT
git archive --format=tar "$release_revision" | tar -xf - -C "$snapshot_root"
(
  cd "$snapshot_root"
  SOURCE_DATE_EPOCH="$source_date_epoch" uv build --no-sources --out-dir "$build_root"
  MOTIF_BALANCE_PRODUCER_REVISION="$release_revision" \
    bash ./scripts/wheel-smoke "$build_root"
)
[[ "$(git rev-parse HEAD)" == "$release_revision" ]] || {
  echo "release source revision changed during build" >&2
  exit 1
}
[[ -z "$(git status --porcelain --untracked-files=all)" ]] || {
  echo "release checkout changed during build" >&2
  exit 1
}
[[ "$(output_identity)" == "$out_identity" ]] || {
  echo "release output directory changed during build" >&2
  exit 1
}
shopt -s nullglob
wheels=("$build_root"/*.whl)
sdists=("$build_root"/*.tar.gz)
[[ ${#wheels[@]} -eq 1 && ${#sdists[@]} -eq 1 ]] || {
  echo "verified build did not contain exactly one wheel and one sdist" >&2
  exit 1
}
for artifact in "${wheels[0]}" "${sdists[0]}"; do
  target="$out_dir/$(basename "$artifact")"
  [[ ! -e "$target" && ! -L "$target" ]] || {
    echo "release artifact target already exists: $(basename "$target")" >&2
    exit 1
  }
  cp -p -n -- "$artifact" "$target"
  [[ -f "$target" && ! -L "$target" ]] || {
    echo "release artifact target is not a regular file: $(basename "$target")" >&2
    exit 1
  }
  cmp -- "$artifact" "$target"
done

attestation_args=(
  create
  --directory "$out_dir"
  --builder-kind "$builder_kind"
  --source-date-epoch "$source_date_epoch"
  --expected-revision "$release_revision"
)
for limitation in "${limitations[@]}"; do
  attestation_args+=(--limitation "$limitation")
done
uv run --locked python scripts/release_attestation.py "${attestation_args[@]}"
[[ "$(output_identity)" == "$out_identity" ]] || {
  echo "release output directory changed during attestation" >&2
  exit 1
}
uv run --locked python scripts/release_attestation.py verify \
  --directory "$out_dir" \
  --repository-root "$repo_root"
[[ "$(git rev-parse HEAD)" == "$release_revision" ]] || {
  echo "release source revision changed during attestation verification" >&2
  exit 1
}
[[ -z "$(git status --porcelain --untracked-files=all)" ]] || {
  echo "release checkout changed during attestation verification" >&2
  exit 1
}
[[ "$(output_identity)" == "$out_identity" ]] || {
  echo "release output directory changed during attestation verification" >&2
  exit 1
}
test -f "$out_dir/release-build-attestation.json"
test -f "$out_dir/SHA256SUMS"

echo "Private prerelease assets prepared: $out_dir"
